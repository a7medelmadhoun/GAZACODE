{
  "name": "gazacode",
  "version": "2.0.0",
  "description": "GAZACODE — a beautiful multi-provider AI chat CLI with Skills & MCP (OpenAI, Gemini, Anthropic, OpenRouter, OpenCode Zen)",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "gazacode": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "setup": "powershell -ExecutionPolicy Bypass -File ./setup.ps1",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "chat",
    "ai",
    "openai",
    "gemini",
    "anthropic",
    "claude",
    "gpt",
    "openrouter",
    "opencode",
    "gazacode",
    "skills",
    "mcp",
    "terminal"
  ],
  "author": "GAZA",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/a7medelmadhoun/GAZACODE.git"
  },
  "bugs": {
    "url": "https://github.com/a7medelmadhoun/GAZACODE/issues"
  },
  "homepage": "https://github.com/a7medelmadhoun/GAZACODE#readme",
  "dependencies": {
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "conf": "^13.0.1",
    "figlet": "^1.7.0",
    "gradient-string": "^2.0.2",
    "inquirer": "^10.2.2",
    "marked": "^14.1.2",
    "marked-terminal": "^7.3.0",
    "ora": "^8.1.0",
    "playwright": "^1.52.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.5.8",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.5.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18"
  }
}
